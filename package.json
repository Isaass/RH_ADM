{
  "name": "pontua-rh-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma SaaS de Gestão de RH, DP e Ponto Eletrônico",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=apps/backend run dev",
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "dev": "npm --workspace=apps/backend run dev",
    "build": "npm run build --workspaces",
    "test": "npm --workspace=apps/backend run test",
    "db:setup": "npm --workspace=apps/backend run db:setup",
    "db:seed": "npm --workspace=apps/backend run db:seed"
  },
  "keywords": [
    "saas",
    "rh",
    "ponto-eletronico",
    "clt",
    "portaria-671",
    "nextjs",
    "nestjs",
    "prisma"
  ],
  "author": "Pontua RH Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
