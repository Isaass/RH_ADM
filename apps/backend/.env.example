# Configurações do Banco de Dados PostgreSQL (Produção / Desenvolvimento)
# Substitua com as credenciais reais configuradas no seu ambiente
DATABASE_URL="postgresql://pontuarh:SEU_PASSWORD_AQUI@127.0.0.1:5432/pontuarh_db?schema=public"

# Segredo de Assinatura de Tokens JWT (Substitua por uma chave forte em produção)
JWT_SECRET="pontuarh-jwt-super-secret-key-production-ready"

# Porta de Execução do Servidor Backend
PORT=3001
